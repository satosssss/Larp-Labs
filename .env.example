# The frontend preview requires no environment variables.
# Backend owners configure service credentials on the server.
# Never place Lumen or database service-role secrets in NEXT_PUBLIC_* variables.

# --- Lumen (server-side only; copy this file to .env and fill in) ---
# .env is gitignored. Never commit real values and never prefix with NEXT_PUBLIC_.
LUMEN_API_KEY=
LUMEN_API_SECRET=
# Lumen gateway origin: https scheme and host only, no path or trailing slash.
# The OCR and AI Chat APIs are published on test/staging gateways only.
LUMEN_API_ORIGIN=
# Optional. If empty, the first ACTIVE AI Chat instance your key can see is used.
LUMEN_AI_CHAT_INSTANCE_ID=
# Set to "mock" to run the whole flow with a clearly labeled fake client.
# Leave empty for the real client. Missing credentials never fall back to mock.
LUMEN_MODE=
