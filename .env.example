# All values are read on the server only. Copy this file to .env.local and fill in.
# .env* is gitignored. Never commit real values and never use a NEXT_PUBLIC_ prefix.

# Required in production. 32+ random characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET=

# Optional limits (defaults shown).
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=10
SHARE_TTL_HOURS=72

# Supabase (not wired yet). Service role key is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Lumen: OCR only ---
# Analysis, explanation and follow-up chat are handled by Gemini (below).
LUMEN_API_KEY=
LUMEN_API_SECRET=
# Lumen gateway origin: https scheme and host only, no path or trailing slash.
# The OCR and AI Chat APIs are published on test/staging gateways only.
LUMEN_API_ORIGIN=
# Optional. If empty, the first ACTIVE AI Chat instance your key can see is used.
LUMEN_AI_CHAT_INSTANCE_ID=
# Set to "mock" to run OCR with a clearly labeled fake client.
# Leave empty for the real client. Missing credentials never fall back to mock.
LUMEN_MODE=

# --- Gemini: review, explanation and follow-up chat ---
GEMINI_API_KEY=
# Bare model id, no "models/" prefix.
GEMINI_MODEL=gemini-2.5-flash
# Optional HTTPS origin override (proxy or test double). Leave empty for the public API.
GEMINI_API_ORIGIN=
# Set to "mock" to run the reasoning steps with a deterministic fake model.
# Leave empty for the real client. Missing credentials never fall back to mock.
GEMINI_MODE=
