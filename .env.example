# All values are read on the server only.
# Never place Lumen or database service-role secrets in NEXT_PUBLIC_* variables.

# Required in production. 32+ random characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET=

# Optional limits (defaults shown).
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=10
SHARE_TTL_HOURS=72

# Supabase (not wired yet). Service role key is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Rate limiting store for production (not wired yet), e.g. Upstash Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Lumen (Member 2).
LUMEN_API_KEY=
LUMEN_BASE_URL=
